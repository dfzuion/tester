rules_version = '2';

// ROD RUNNERS RAFFLES - Firestore security rules
//
// Principle: the client may read what it is entitled to see and may write only
// its own profile, favourites and notification read-state. Everything that
// touches money, entry numbers, competition status or results is written by
// Cloud Functions using the Admin SDK, which bypasses these rules. So every
// collection below denies client writes on those paths outright.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function hasRole(r) { return signedIn() && request.auth.token.role == r; }
    function isSuperAdmin() { return hasRole('super_admin'); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    // Only these profile fields may ever be self-edited.
    function editableProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName','phone','address','photoUrl','marketingOptIn',
                  'notificationPreferences','fcmTokens','updatedAt']);
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid);
      allow update: if (isSelf(uid) && editableProfileFields()) || isAdmin();
      allow delete: if false; // handled by deleteMyAccount()

      match /notifications/{notificationId} {
        allow read: if isSelf(uid) || isAdmin();
        // The customer may only flip a notification to read.
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // Signup handoff document: written once at registration, read by a trigger.
    match /userSignups/{uid} {
      allow create: if isSelf(uid);
      allow read, update, delete: if false;
    }

    match /competitions/{id} {
      // Drafts and cancelled raffles stay invisible to customers.
      allow get, list: if isAdmin() || resource.data.status in ['live','paused','closed','drawn'];
      allow write: if false; // admin writes go through callable functions
    }

    match /prizes/{id} {
      allow read: if true;
      allow write: if false;
    }

    // A customer sees only their own entries. Winning numbers become public
    // through the winners collection, never through raw entry documents.
    match /entries/{id} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /orders/{id} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /payments/{id} { allow read, write: if false; }   // webhook ledger, server only
    match /draws/{id}    { allow read: if isAdmin(); allow write: if false; }
    match /counters/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /mail/{id}     { allow read, write: if false; }

    /**
     * The document id is the uid and the London date, so a customer can check
     * whether they have used today's spin without calling a function - and a
     * missing document is the answer, which a resource.data rule could not
     * express. Only spinDailyWheel writes here.
     */
    match /dailySpins/{id} {
      allow get: if signedIn() && id.matches(request.auth.uid + '_.*');
      allow list: if isAdmin();
      allow write: if false;
    }

    /**
     * Unclaimed prizes are invisible to every client - knowing which numbers
     * are loaded would break the game. A won prize is readable by the person
     * who won it, and by anyone for the public "recent wins" feed.
     */
    /**
     * Credit is server-money: the balance lives on the user document and every
     * movement is an immutable ledger row. Customers read their own ledger and
     * nothing else; only the Admin SDK ever writes here.
     */
    match /users/{uid}/creditLedger/{entry} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    /** Coupon values and caps stay private - the app redeems through a function. */
    match /creditCoupons/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /couponRedemptions/{id} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /instantWins/{id} {
      allow get, list: if isAdmin()
        || (resource.data.status == "won"
            && (resource.data.wonBy == request.auth.uid || resource.data.published == true));
      allow write: if false;
    }

    match /winners/{id} {
      // A customer can always see their own wins, published or not. Without
      // this, "My wins" queried by winnerUserId with no published filter, and
      // Firestore rejected the whole listing - so a win the admin had not yet
      // published was invisible to the person who had won it.
      allow get, list: if isAdmin()
        || resource.data.published == true
        || (signedIn() && resource.data.winnerUserId == request.auth.uid);
      allow write: if false;
    }

    match /favourites/{id} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if verified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','competitionId','createdAt']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /promotions/{id} {
      // Codes are validated server-side; the app only needs the public ones.
      allow get, list: if resource.data.active == true && resource.data.publiclyListed == true;
      allow write: if false;
    }
    match /promotionRedemptions/{id} { allow read, write: if false; }

    match /referrals/{id} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.referredUserId == request.auth.uid);
      allow write: if false;
    }

    match /supportTickets/{id} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // created and replied to via callable functions
      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (signedIn() && get(/databases/$(database)/documents/supportTickets/$(id)).data.userId == request.auth.uid);
        allow write: if false;
      }
    }

    match /faq/{id} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow write: if false;
    }

    match /appContent/{id} {
      allow get, list: if true;
      allow write: if false;
    }

    match /emailTemplates/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Append-only. No client, not even a Super Admin, may alter history.
    match /auditLogs/{id} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /adminUsers/{uid} {
      allow get: if isSelf(uid) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow write: if false; // setAdminRole() only
    }

    match /{document=**} { allow read, write: if false; }
  }
}
